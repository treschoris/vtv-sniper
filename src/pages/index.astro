---
import Layout from '../layouts/Layout.astro';
---

<Layout title="VTV Próxima: Calculadora Decreto 139 (Abril 2026)">
    <main>
        <!-- 1. HEADER & TRUST SIGNALS -->
        <header class="header">
            <div class="trust-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 12 15 16 10"></polyline>
                </svg>
                Herramienta gratuita e informativa
            </div>
            <h1>¿Cuándo me toca la VTV?</h1>
            <p class="subtitle">Calculadora oficial de vencimientos basada en el Decreto 139/2026.</p>

            <div class="trust-stats">
                <div class="stat-item">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label">Conductores ayudados</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Gratis siempre</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">2026</div>
                    <div class="stat-label">Info actualizada</div>
                </div>
            </div>
        </header>

        <!-- 2. MAIN CALCULATOR CARD -->
        <div class="card">
            <div class="form-section">
                <label class="section-label">Lugar de Patentamiento:</label>
                <select id="juris">
                    <option value="CABA">CABA (Decreto 139 2026)</option>
                    <option value="PBA">Provincia de Buenos Aires</option>
                </select>
            </div>

            <div class="grid-inputs">
                <div class="form-section">
                    <label class="section-label">Año del auto:</label>
                    <input id="year" type="number" value="2024" placeholder="Ej: 2022">
                </div>
                <div class="form-section">
                    <label class="section-label">Kilometraje:</label>
                    <input id="km" type="number" value="0" placeholder="Ej: 45000">
                </div>
            </div>

            <div id="caba-extra-fields" class="form-section">
                <label class="section-label">Mes de Patentamiento (0km):</label>
                <select id="patentMonth">
                    {["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"].map((m, i) => (
                        <option value={i}>{m}</option>
                    ))}
                </select>
            </div>

            <div class="form-section">
                <label class="section-label">Mi patente termina en:</label>
                <select id="digit">
                    {[2,3,4,5,6,7,8,9,0,1].map(d => <option value={d} selected={d===2}>{d}</option>)}
                </select>
            </div>

            <button id="calcBtn" class="button">Ver Fecha VTV según patente</button>

            <!-- RESULTS & LEAD GEN -->
            <div id="result-container" class="hidden">
                <div class="divider"></div>
                <div id="result"></div>
                <button id="retryBtn" class="retry-link">Nueva Consulta</button>

                <div class="alert-section">
                    <div class="alert-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        ¿Querés un aviso 30 días antes?
                    </div>
                    <form id="vtv-form" name="vtv-avisos-2026" method="POST" data-netlify="true">
                        <input type="hidden" name="form-name" value="vtv-avisos-2026" />
                        <input type="email" name="email" placeholder="Tu email" required style="margin-bottom: 0.5rem;">
                        <button type="submit" class="button-secondary">Avisame y enviar Checklist PDF</button>
                    </form>
                    <div id="form-success" class="hidden success-msg">¡Listo! Te avisaremos por email. ✅</div>
                </div>
            </div>
        </div>

        <!-- 3. FAQ SECTION (Bloque 8) -->
        <section class="faq-section">
            <h2 class="faq-header">Preguntas Frecuentes</h2>
            <article class="faq-item">
                <h3 class="faq-question">¿Cuándo es obligatoria la VTV en CABA?</h3>
                <p class="faq-answer">Según el Decreto 139, los autos particulares deben realizar su primera VTV al cumplir 4 años (tomando el mes de patentamiento) o alcanzar los 64.000 km, lo que ocurra primero.</p>
            </article>
            <article class="faq-item">
                <h3 class="faq-question">¿Qué mes me toca la VTV según mi patente?</h3>
                <p class="faq-answer">El cronograma es: Febrero (2), Marzo (3), Abril (4), Mayo (5), Junio (6), Julio (7), Agosto (8), Septiembre (9), Octubre (0) y Noviembre (1).</p>
            </article>
        </section>

        <!-- 4. FOOTER (Bloque 8) -->
        <footer class="footer">
            <div class="warning-box">
                <strong>Aviso Importante:</strong> Herramienta informativa independiente. No somos el sitio oficial ni solicitamos pagos o datos de tarjetas.
            </div>

            <div class="links-section">
                <p class="links-title">Links Oficiales:</p>
                <div class="official-link">📍 <strong>CABA:</strong> <a href="https://suvtv.com.ar/turnos" target="_blank">suvtv.com.ar</a></div>
                <div class="official-link">📍 <strong>Provincia:</strong> <a href="https://vtv.minfra.gba.gob.ar" target="_blank">vtv.minfra.gba.gob.ar</a></div>
            </div>

            <div class="security-footer">
                <div class="security-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    Sin datos de pago
                </div>
                <div class="security-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    Información verificada
                </div>
            </div>
        </footer>
    </main>

    <script>
        import { getVTVStatus } from '../logic/vtvLogic.js';

        const juris = document.getElementById('juris');
        const extraFields = document.getElementById('caba-extra-fields');
        const btn = document.getElementById('calcBtn');
        const resultContainer = document.getElementById('result-container');
        const retryBtn = document.getElementById('retryBtn');
        const vtvForm = document.getElementById('vtv-form');

        juris.addEventListener('change', (e) => {
            extraFields.classList.toggle('hidden', e.target.value === 'PBA');
        });

        btn.addEventListener('click', () => {
            const res = getVTVStatus(
                juris.value,
                parseInt(document.getElementById('year').value) || 0,
                parseInt(document.getElementById('km').value) || 0,
                parseInt(document.getElementById('digit').value),
                parseInt(document.getElementById('patentMonth').value)
            );

            resultContainer.classList.remove('hidden');
            btn.classList.add('hidden');

            document.getElementById('result').innerHTML = `
                <div class="status-card" style="border-left: 5px solid ${res.color};">
                    <h2 style="color: ${res.color}; margin:0;">${res.status}</h2>
                    <p style="margin: 0.5rem 0; font-weight: 500;">${res.info}</p>
                    <p style="font-size: 0.85rem; color: #64748B;"><strong>Acción:</strong> ${res.action}</p>
                </div>
            `;
        });

        retryBtn.addEventListener('click', () => {
            resultContainer.classList.add('hidden');
            btn.classList.remove('hidden');
        });

        if (vtvForm) {
            vtvForm.addEventListener("submit", (e) => {
                e.preventDefault();
                fetch("/", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: new URLSearchParams(new FormData(vtvForm) as any).toString(),
                }).then(() => {
                    vtvForm.classList.add('hidden');
                    document.getElementById('form-success').classList.remove('hidden');
                });
            });
        }
    </script>
</Layout>

<style>
    :root { --primary-blue: #2563EB; --primary-hover: #1D4ED8; --slate-navy: #1E293B; --bg: #F8FAFC; --white: #FFFFFF; --radius: 8px; }
    main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem; animation: fadeIn 0.5s ease-out; }
    .header { text-align: center; padding-bottom: 2rem; }
    .trust-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: #DBEAFE; color: #1E40AF; padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem; border: 1px solid #BFDBFE; }
    .trust-badge svg { width: 16px; height: 16px; }
    .trust-stats { display: flex; justify-content: center; gap: 2rem; margin-top: 1.5rem; padding: 1rem; background: var(--white); border-radius: var(--radius); border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .stat-number { font-size: 1.5rem; font-weight: 700; color: var(--primary-blue); }
    .stat-label { font-size: 0.75rem; color: #6B7280; text-transform: uppercase; font-weight: 600; }
    .card { background: var(--white); border: 1px solid #E2E8F0; border-radius: var(--radius); padding: 2.5rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); margin-bottom: 2rem; }
    .grid-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-section { margin-bottom: 1.5rem; }
    .section-label { display: block; font-weight: 600; font-size: 0.875rem; color: #374151; margin-bottom: 0.5rem; }
    input, select { width: 100%; padding: 0.75rem; border: 1px solid #D1D5DB; border-radius: var(--radius); font-size: 1rem; background: white; }
    .button { background-color: var(--primary-blue); color: white; padding: 1rem; border-radius: var(--radius); font-weight: 600; border: none; cursor: pointer; width: 100%; transition: all 0.2s; }
    .button:hover { background-color: var(--primary-hover); transform: translateY(-1px); }
    .button-secondary { background-color: #16A34A; color: white; padding: 1rem; border-radius: var(--radius); width: 100%; border: none; cursor: pointer; font-weight: 600; margin-top: 0.5rem; }
    .alert-section { background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: var(--radius); padding: 1.5rem; margin-top: 1.5rem; }
    .alert-title { color: #166534; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .alert-title svg { width: 18px; height: 18px; }
    .faq-section { margin-top: 3rem; }
    .faq-header { font-size: 1.5rem; border-bottom: 2px solid #E2E8F0; padding-bottom: 1rem; margin-bottom: 1.5rem; font-weight: 700; }
    .faq-item { background: white; padding: 1.5rem; border-radius: var(--radius); border: 1px solid #E5E7EB; margin-bottom: 1rem; }
    .faq-question { font-size: 1.05rem; color: var(--slate-navy); margin-bottom: 0.5rem; font-weight: 600; }
    .faq-answer { font-size: 0.95rem; color: #4B5563; line-height: 1.6; }
    .footer { text-align: center; padding: 2rem; background: var(--white); border: 1px solid #E2E8F0; border-radius: var(--radius); margin-top: 3rem; }
    .warning-box { background: #FFFBEB; border: 1px solid #FCD34D; padding: 1rem; border-radius: 8px; font-size: 0.85rem; color: #92400E; margin-bottom: 1.5rem; }
    .official-link { margin-bottom: 0.5rem; font-size: 0.9rem; }
    .official-link a { color: var(--primary-blue); font-weight: 600; text-decoration: none; }
    .security-footer { display: flex; justify-content: center; gap: 2rem; margin-top: 2rem; color: #9CA3AF; font-size: 0.8rem; border-top: 1px solid #E5E7EB; padding-top: 1rem; }
    .security-item { display: flex; align-items: center; gap: 0.5rem; }
    .security-item svg { width: 14px; height: 14px; color: #10B981; }
    .hidden { display: none; }
    .success-msg { color: #166534; font-weight: 600; text-align: center; margin-top: 1rem; background: #DCFCE7; padding: 1rem; border-radius: 8px; }
    .status-card { background: #F8FAFC; padding: 1.5rem; border-radius: var(--radius); margin-top: 1rem; }
    .divider { height: 1px; background: #E5E7EB; margin: 2rem 0; }
    .retry-link { background: none; border: none; color: #64748B; text-decoration: underline; cursor: pointer; display: block; margin: 1rem auto; font-size: 0.875rem; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 640px) { .grid-inputs { grid-template-columns: 1fr; } .trust-stats { flex-direction: column; gap: 1rem; } }
</style>

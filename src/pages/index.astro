---
import Layout from '../layouts/Layout.astro';
---
<Layout title="VTV Próxima: Calculá tu vencimiento Decreto 139">
    <div class="card">
        <header style="text-align: center;">
            <h1 style="margin-bottom: 0;">VTV Próxima</h1>
            <p style="color: #64748b; margin-bottom: 1.5rem;">Calculadora oficial 2026</p>
        </header>
        
        <label>Jurisdicción:</label>
        <select id="juris">
            <option value="CABA">CABA (Decreto 139)</option>
            <option value="PBA">Provincia de Buenos Aires</option>
        </select>
        
        <div id="caba-extra-fields">
            <label>Mes de Patentamiento:</label>
            <select id="patentMonth">
                {["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"].map((m, i) => (
                    <option value={i}>{m}</option>
                ))}
            </select>
        </div>

        <input id="year" type="number" placeholder="Año (ej. 2022)" />
        <input id="km" type="number" placeholder="Kilometraje actual" />
        
        <label>Patente termina en:</label>
        <select id="digit">
            {[2,3,4,5,6,7,8,9,0,1].map(d => <option value={d}>{d}</option>)}
        </select>
        
        <button id="calcBtn">Calcular Vencimiento</button>
        
        <div id="result" style="margin-top: 1.5rem; text-align: center; font-weight: 500;"></div>
    </div>

    <script>
    // 1. FIXED PATH: Ensure this matches your folder (usually /src/vtvLogic.js)
    // If your file is in 'src/logic/vtvLogic.js', use: '../logic/vtvLogic.js'
    import { getVTVStatus } from '../vtvLogic.js'; 

    // 2. TYPE CASTING: Telling TypeScript these are Input/Select elements
    const juris = document.getElementById('juris') as HTMLSelectElement;
    const extraFields = document.getElementById('caba-extra-fields') as HTMLElement;
    const btn = document.getElementById('calcBtn') as HTMLButtonElement;

    if (juris && extraFields && btn) {
        // Toggle Month Field visibility
        juris.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            if (target.value === 'PBA') {
                extraFields.classList.add('hidden');
            } else {
                extraFields.classList.remove('hidden');
            }
        });

        btn.addEventListener('click', () => {
            // Fetching values with proper type casting
            const yearInput = document.getElementById('year') as HTMLInputElement;
            const kmInput = document.getElementById('km') as HTMLInputElement;
            const digitSelect = document.getElementById('digit') as HTMLSelectElement;
            const monthSelect = document.getElementById('patentMonth') as HTMLSelectElement;
            const resultDiv = document.getElementById('result') as HTMLElement;

            const res = getVTVStatus(
                juris.value,
                parseInt(yearInput.value) || 0,
                parseInt(kmInput.value) || 0,
                parseInt(digitSelect.value),
                parseInt(monthSelect.value)
            );

            resultDiv.innerHTML = `
                <div style="color: ${res.color || 'inherit'}">
                    <h2 style="margin:0">${res.status}</h2>
                    <p>${res.info}</p>
                </div>
            `;
        });
    }
</script>

</Layout>

---
// This is where the magic happens behind the scenes
---
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>VTV Sniper 2026</title>
    <style>
        body { font-family: sans-serif; background: #f0f2f5; padding: 20px; }
        .card { background: white; padding: 20px; border-radius: 12px; max-width: 400px; margin: auto; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        input, select, button { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
        button { background: #007bff; color: white; font-weight: bold; cursor: pointer; border: none; }
        #result { margin-top: 20px; padding: 15px; border-radius: 8px; display: none; }
        .exento { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .obligatorio { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
</head>
<body>
    <div class="card">
        <h1>VTV Sniper 2026</h1>
        <p>Calculadora Decreto 139</p>
        
        <select id="juris">
            <option value="CABA">CABA (Decreto 139)</option>
            <option value="PBA">Provincia Buenos Aires</option>
        </select>
        
        <input id="year" type="number" placeholder="Año del auto (ej. 2022)" />
        <input id="km" type="number" placeholder="Kilometraje (ej. 45000)" />
        
        <select id="digit">
            {[2,3,4,5,6,7,8,9,0,1].map(d => <option value={d}>Patente termina en {d}</option>)}
        </select>
        
        <button id="calcBtn">Consultar Fecha</button>
        <div id="result"></div>
    </div>

    <script>
        import { getVTVStatus, digitToMonth } from '../utils/vtvLogic.js';

        document.getElementById('calcBtn').addEventListener('click', () => {
            const juris = document.getElementById('juris').value;
            const year = parseInt(document.getElementById('year').value);
            const km = parseInt(document.getElementById('km').value);
            const digit = document.getElementById('digit').value;

            const res = getVTVStatus(juris, year, km);
            const resultDiv = document.getElementById('result');
            
            resultDiv.style.display = 'block';
            resultDiv.className = res.status === 'Exento' ? 'exento' : 'obligatorio';
            resultDiv.innerHTML = `<strong>${res.status}</strong><br>${res.info}<br>Tu mes asignado: <b>${digitToMonth[digit]}</b>`;
        });
    </script>
</body>
</html>

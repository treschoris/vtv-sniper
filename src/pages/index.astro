---
import Layout from '../layouts/Layout.astro';
// (Keep your FAQs array here as before)
---

<Layout title="VTV Próxima: Calculadora Decreto 139 (Abril 2026)">
    <div class="card shadow-lg">
        <header class="text-center">
            <div class="status-pill">✅ Actualizado Abril 2026</div>
            <h1 class="title">VTV Próxima</h1>
            <p class="subtitle">Calculadora oficial de vencimientos</p>
        </header>
        
        <div class="input-group">
            <label for="juris">📍 Jurisdicción</label>
            <select id="juris">
                <option value="CABA">CABA (Decreto 139)</option>
                <option value="PBA">Provincia de Buenos Aires</option>
            </select>
        </div>

        <div class="grid-inputs">
            <div class="input-group">
                <label for="year">Año del Auto</label>
                <!-- FIXED: Min 1900, Max 2026, starts at 2024 -->
                <input id="year" type="number" min="1900" max="2026" value="2024" placeholder="Ej: 2021" />
            </div>
            <div class="input-group">
                <label for="km">Kilometraje</label>
                <!-- FIXED: Min 0, starts at 0 -->
                <input id="km" type="number" min="0" value="0" placeholder="Ej: 45000" />
            </div>
        </div>

        <div id="caba-extra-fields" class="input-group">
            <label for="patentMonth">Mes de Patentamiento (0km)</label>
            <select id="patentMonth">
                {["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"].map((m, i) => (
                    <option value={i}>{m}</option>
                ))}
            </select>
        </div>
        
        <div class="input-group">
            <label for="digit">Patente termina en:</label>
            <select id="digit">
                {[2,3,4,5,6,7,8,9,0,1].map(d => <option value={d}>{d}</option>)}
            </select>
        </div>
        
        <button id="calcBtn" class="primary-btn">Calcular Vencimiento</button>
        
        <!-- HIDDEN SECTION: Results + Lead Gen -->
        <div id="reveal-area" class="hidden">
            <hr />
            <div id="result" class="result-box"></div>
            
            <button id="retryBtn" style="background: none; border: none; color: #64748B; font-size: 0.8rem; text-decoration: underline; cursor: pointer; margin-bottom: 1rem;">Calcular otro vehículo</button>

            <form id="vtv-form" name="vtv-avisos-2026" method="POST" data-netlify="true" class="form-container">
                <input type="hidden" name="form-name" value="vtv-avisos-2026" />
                <p class="form-title">🔔 ¿Querés un aviso 30 días antes?</p>
                <div class="form-row">
                    <input type="email" name="email" placeholder="Tu email" required />
                    <button type="submit" class="submit-btn">Avisame</button>
                </div>
            </form>
            <div id="form-success" class="hidden success-box">
                <p><strong>¡Listo! Te avisaremos por email. ✅</strong></p>
            </div>
        </div>
    </div>

    <!-- (Keep FAQ and Footer here as before) -->

    <script>
    import { getVTVStatus } from './vtvLogic.js'; 

    const juris = document.getElementById('juris') as HTMLSelectElement;
    const extraFields = document.getElementById('caba-extra-fields') as HTMLElement;
    const btn = document.getElementById('calcBtn') as HTMLButtonElement;
    const retryBtn = document.getElementById('retryBtn') as HTMLButtonElement;
    const revealArea = document.getElementById('reveal-area') as HTMLElement;
    const vtvForm = document.getElementById('vtv-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success') as HTMLElement;

    if (juris && btn) {
        juris.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            target.value === 'PBA' ? extraFields.classList.add('hidden') : extraFields.classList.remove('hidden');
        });

        btn.addEventListener('click', () => {
            const yearVal = (document.getElementById('year') as HTMLInputElement).value;
            const kmVal = (document.getElementById('km') as HTMLInputElement).value;
            const res = getVTVStatus(
                juris.value,
                parseInt(yearVal) || 0,
                parseInt(kmVal) || 0,
                parseInt((document.getElementById('digit') as HTMLSelectElement).value),
                parseInt((document.getElementById('patentMonth') as HTMLSelectElement).value)
            );

            revealArea.classList.remove('hidden');
            btn.classList.add('hidden'); // Hide the main button so they focus on the result

            const resultDiv = document.getElementById('result') as HTMLElement;
            resultDiv.innerHTML = `
                <div class="status-card" style="border-left: 5px solid ${res.color || '#2563EB'}">
                    <h2 style="color: ${res.color || 'inherit'}; margin:0; font-size: 1.3rem;">${res.status}</h2>
                    <p style="margin:5px 0; font-size: 0.95rem;">${res.info}</p>
                    <p style="font-size: 0.8rem; color: #64748B;">${res.action}</p>
                </div>
            `;
        });

        retryBtn.addEventListener('click', () => {
            revealArea.classList.add('hidden');
            btn.classList.remove('hidden');
            (document.getElementById('km') as HTMLInputElement).value = "0";
        });
    }

    if (vtvForm) {
        vtvForm.addEventListener("submit", (e) => {
            e.preventDefault();
            fetch("/", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams(new FormData(vtvForm) as any).toString(),
            }).then(() => {
                vtvForm.classList.add('hidden');
                successMsg.classList.remove('hidden');
            });
        });
    }
    </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="VTV Próxima: Calculadora Decreto 139 (Abril 2026)">
    <div class="card shadow-lg">
        <header class="text-center">
            <div class="status-pill">✅ Actualizado Abril 2026</div>
            <h1 class="title">VTV Próxima</h1>
            <p class="subtitle">Calculadora oficial de vencimientos</p>
        </header>
        
        <div class="input-group">
            <label for="juris">📍 Jurisdicción</label>
            <select id="juris">
                <option value="CABA">CABA (Decreto 139)</option>
                <option value="PBA">Provincia de Buenos Aires</option>
            </select>
        </div>

        <div class="grid-inputs">
            <div class="input-group">
                <label for="year">Año del Auto</label>
                <input id="year" type="number" min="1900" max="2026" value="2024" />
            </div>
            <div class="input-group">
                <label for="km">Kilometraje</label>
                <input id="km" type="number" min="0" value="0" />
            </div>
        </div>

        <div id="caba-extra-fields" class="input-group">
            <label for="patentMonth">Mes de Patentamiento (0km)</label>
            <select id="patentMonth">
                {["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"].map((m, i) => (
                    <option value={i}>{m}</option>
                ))}
            </select>
        </div>
        
        <div class="input-group">
            <label for="digit">Patente termina en:</label>
            <select id="digit">
                {[2,3,4,5,6,7,8,9,0,1].map(d => <option value={d}>{d}</option>)}
            </select>
        </div>
        
        <button id="calcBtn" class="primary-btn">Calcular Vencimiento</button>
        
        <div id="reveal-area" class="hidden">
            <hr class="divider" />
            <div id="result"></div>
            
            <button id="retryBtn" class="retry-link">Calcular otro vehículo</button>

            <form id="vtv-form" name="vtv-avisos-2026" method="POST" data-netlify="true" class="form-container">
                <input type="hidden" name="form-name" value="vtv-avisos-2026" />
                <p class="form-title">🔔 ¿Querés un aviso 30 días antes?</p>
                <div class="form-row">
                    <input type="email" name="email" placeholder="Tu email" required />
                    <button type="submit" class="submit-btn">Avisame</button>
                </div>
            </form>
            <div id="form-success" class="hidden success-box">
                <p><strong>¡Listo! Te avisaremos por email. ✅</strong></p>
            </div>
        </div>
    </div>

    <!-- SECCIÓN FAQ -->
    <section class="faq-container">
        <h2>Preguntas Frecuentes</h2>
        <div class="faq-item">
            <p><strong>¿Qué cambió con el Decreto 139?</strong></p>
            <p>En CABA, los autos nuevos ahora están exentos por 4 años o 64.000km. Luego, la VTV es cada 2 años hasta los 10 años de antigüedad.</p>
        </div>
        <div class="faq-item">
            <p><strong>¿Provincia (PBA) también cambió?</strong></p>
            <p>No. PBA mantiene la obligatoriedad anual para autos de más de 2 años, ignorando el decreto nacional por el momento.</p>
        </div>
    </section>

    <footer class="footer">
        <p>VTV Próxima 2026 - Guía independiente informativa.</p>
    </footer>

    <style>
        .text-center { text-align: center; }
        .status-pill { display: inline-block; background: #DCFCE7; color: #166534; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; margin-bottom: 10px; }
        .title { margin: 0; color: var(--navy); }
        .subtitle { color: #64748B; margin-top: 5px; }
        .input-group { margin-bottom: 1.2rem; text-align: left; }
        .input-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 5px; color: #475569; }
        .grid-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .primary-btn { background: var(--primary); color: white; border: none; padding: 1rem; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1rem; transition: background 0.2s; }
        .primary-btn:hover { background: #1D4ED8; }
        .divider { border: 0; border-top: 1px solid #E2E8F0; margin: 2rem 0; }
        .retry-link { background: none; border: none; color: #64748B; font-size: 0.85rem; text-decoration: underline; cursor: pointer; display: block; margin: 0 auto 1.5rem; }
        .form-container { background: #F1F5F9; padding: 1.5rem; border-radius: 8px; }
        .form-title { font-weight: bold; font-size: 0.9rem; margin-bottom: 10px; }
        .form-row { display: flex; gap: 8px; }
        .submit-btn { background: #059669; color: white; border: none; padding: 0 15px; border-radius: 6px; cursor: pointer; }
        .success-box { background: #DCFCE7; color: #166534; padding: 1rem; border-radius: 8px; text-align: center; }
        .faq-container { max-width: 500px; margin: 3rem auto; padding: 0 1.5rem; }
        .faq-item { margin-bottom: 1.5rem; font-size: 0.9rem; border-bottom: 1px solid #E2E8F0; padding-bottom: 1rem; }
        .footer { text-align: center; color: #94A3B8; font-size: 0.8rem; margin: 2rem 0; }
        .status-card { padding: 1rem; background: #F8FAFC; border-radius: 8px; text-align: left; }
    </style>

    <script>
        import { getVTVStatus } from '../logic/vtvLogic.js'; 

        const juris = document.getElementById('juris');
        const extraFields = document.getElementById('caba-extra-fields');
        const btn = document.getElementById('calcBtn');
        const retryBtn = document.getElementById('retryBtn');
        const revealArea = document.getElementById('reveal-area');
        const vtvForm = document.getElementById('vtv-form');

        // Logic for hiding/showing fields
        juris.addEventListener('change', (e) => {
            extraFields.classList.toggle('hidden', e.target.value === 'PBA');
        });

        btn.addEventListener('click', () => {
            const res = getVTVStatus(
                juris.value,
                parseInt(document.getElementById('year').value),
                parseInt(document.getElementById('km').value),
                parseInt(document.getElementById('digit').value),
                parseInt(document.getElementById('patentMonth').value)
            );

            revealArea.classList.remove('hidden');
            btn.classList.add('hidden');

            document.getElementById('result').innerHTML = `
                <div class="status-card" style="border-left: 5px solid ${res.color}">
                    <h2 style="color: ${res.color}; margin:0;">${res.status}</h2>
                    <p style="margin:5px 0;">${res.info}</p>
                    <p style="font-size: 0.85rem; color: #64748B;">${res.action}</p>
                </div>
            `;
        });

        retryBtn.addEventListener('click', () => {
            revealArea.classList.add('hidden');
            btn.classList.remove('hidden');
        });
    </script>
</Layout>

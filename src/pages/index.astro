---
import Layout from '../layouts/Layout.astro';

// This is the logic for the calculator
const currentYear = new Date().getFullYear();
---

<Layout title="¿Cuándo me toca la VTV? – Calendario y Alerta de Turnos 2024-2025">
	<main class="max-w-2xl mx-auto p-6 font-sans text-gray-800">
		
		<!-- Header / SEO H1 -->
		<header class="text-center mb-10">
			<h1 class="text-3xl font-bold text-green-700 mb-2">Consultá el Vencimiento de tu VTV</h1>
			<p class="text-lg text-gray-600 italic">Evitá multas. Enterate cuándo te toca y recibí un aviso al toque.</p>
		</header>

		<!-- The Calculator Tool -->
		<section class="bg-white shadow-lg rounded-lg p-8 border border-gray-100 mb-10">
			<h2 class="text-xl font-semibold mb-4 text-center">Calculadora de Vencimiento</h2>
			<p class="text-sm text-center mb-6 text-gray-500">Ingresá el último número de tu patente (dominio):</p>
			
			<div class="flex justify-center gap-2 mb-8 flex-wrap">
				{[2, 3, 4, 5, 6, 7, 8, 9, 0, 1].map((num) => (
					<button class="w-12 h-12 rounded-full border-2 border-green-600 text-green-700 font-bold hover:bg-green-600 hover:text-white transition-colors">
						{num}
					</button>
				))}
			</div>

			<div id="result" class="text-center p-4 bg-green-50 rounded-md hidden">
				<p class="text-lg font-medium">Tu mes de renovación es: <span id="month-name" class="font-bold text-green-800 text-xl uppercase">---</span></p>
			</div>
		</section>

		<!-- Netlify Form (Email Capture) -->
		<section class="bg-blue-50 p-6 rounded-lg border border-blue-100 mb-10">
			<h3 class="font-bold text-lg mb-2 text-blue-900">¿Querés que te avisemos?</h3>
			<p class="text-sm mb-4 text-blue-800">Dejanos tu mail y te chiflamos cuando se habiliten turnos para tu terminación.</p>
			
			<form name="vtv-reminders" method="POST" data-netlify="true" class="flex flex-col sm:flex-row gap-2">
				<input type="email" name="email" placeholder="Tu email" required class="flex-1 p-2 border border-blue-300 rounded" />
				<button type="submit" class="bg-blue-700 text-white px-6 py-2 rounded font-bold hover:bg-blue-800">Avisame</button>
			</form>
		</section>

		<!-- SEO FAQ Section -->
		<section class="space-y-6 mb-10">
			<h3 class="text-2xl font-bold text-gray-700 border-b pb-2">Preguntas Frecuentes</h3>
			
			<div>
				<h4 class="font-bold">¿Cómo saber cuándo vence mi VTV por la patente?</h4>
				<p class="text-gray-600">El número final de tu patente indica el mes que te toca. Por ejemplo: las patentes terminadas en 2 vencen en febrero, y las terminadas en 0 vencen en octubre. Enero y diciembre no tienen un número asignado para permitir rezagados.</p>
			</div>

			<div>
				<h4 class="font-bold">¿Qué pasa si tengo la VTV vencida en Provincia de Buenos Aires?</h4>
				<p class="text-gray-600 text-sm">Circular con la oblea vencida puede resultar en multas costosas. Esta herramienta te ayuda a planificar con tiempo para que no te quedes sin turno.</p>
			</div>
		</section>

		<!-- Trust Disclaimer -->
		<footer class="text-center py-10 border-t border-gray-200">
			<p class="text-xs text-gray-500 uppercase tracking-widest font-bold mb-4">Información Importante</p>
			<div class="bg-gray-50 p-4 rounded text-sm text-gray-600 inline-block text-left max-w-md border">
				<p class="mb-2">⚠️ <strong>Este es un sitio independiente y gratuito.</strong></p>
				<p class="mb-2">No somos el sitio oficial del Gobierno ni gestionamos turnos directamente. No solicitamos datos de tarjetas ni cobramos por este servicio.</p>
				<p>Para reservar y pagar tu turno oficial, visitá siempre: <a href="https://gba.gob.ar" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline font-bold">vtv.minfra.gba.gob.ar</a></p>
			</div>
		</footer>

	</main>
</Layout>

<script>
	// Simple logic to show the month based on the button clicked
	const buttons = document.querySelectorAll('button');
	const resultDiv = document.getElementById('result');
	const monthSpan = document.getElementById('month-name');
	
	const months = {
		'2': 'Febrero', '3': 'Marzo', '4': 'Abril', '5': 'Mayo', 
		'6': 'Junio', '7': 'Julio', '8': 'Agosto', '9': 'Septiembre', 
		'0': 'Octubre', '1': 'Noviembre'
	};

	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			const num = btn.innerText;
			if (months[num]) {
				monthSpan.innerText = months[num];
				resultDiv.classList.remove('hidden');
			}
		});
	});
</script>

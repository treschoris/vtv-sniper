---
interface Props {
	title?: string;
}
const { title = "¿Cuándo me toca la VTV? – Cronograma de Turnos 2024-2025" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta property="og:locale" content="es_AR" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#007bff" />

		<!-- SEO Setup -->
		<title>{title}</title>
		<meta name="description" content="Calculadora gratuita de vencimiento VTV para CABA (Decreto 139) y Provincia. Consultá cuándo te toca según patente, año y KM." />
		<link rel="canonical" href="https://netlify.app" />

		<!-- Social Media -->
		<meta property="og:title" content="VTV Turnos: Calculá tu vencimiento" />
		<meta property="og:description" content="Evitá multas. Consultá cuándo te toca renovar la VTV al toque." />
		<meta property="og:type" content="website" />

		<!-- Google Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Calculadora VTV CABA y Provincia",
  "operatingSystem": "All",
  "applicationCategory": "UtilityApplication",
  "description": "Calculadora gratuita para consultar el vencimiento de la VTV según patente, año y kilometraje para CABA y Provincia de Buenos Aires.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "ARS"
  },
  "author": {
    "@type": "Person",
    "name": "Turnos VTV Ya"
  }
}
</script>

	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html, body { margin: 0; width: 100%; height: 100%; }
</style>


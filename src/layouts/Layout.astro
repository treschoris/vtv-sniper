---
interface Props {
	title?: string;
}
const { title = "¿Cuándo me toca la VTV? – Cronograma de Turnos 2024-2025" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Setup -->
		<title>{title}</title>
		<meta name="description" content="Calculadora gratuita de vencimiento VTV para CABA (Decreto 139) y Provincia. Consultá cuándo te toca según patente, año y KM." />
		<link rel="canonical" href="https://netlify.app" />

		<!-- Social Media -->
		<meta property="og:title" content="VTV Turnos: Calculá tu vencimiento" />
		<meta property="og:description" content="Evitá multas. Consultá cuándo te toca renovar la VTV al toque." />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html, body { margin: 0; width: 100%; height: 100%; }
</style>


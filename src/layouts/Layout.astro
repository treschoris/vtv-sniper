---
interface Props { title?: string; }
const { title = "VTV Próxima – Calculadora de Vencimientos 2026" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="stylesheet" href="https://googleapis.com">
		<style is:global>
			:root {
				--primary: #2563EB; --navy: #1E293B; --bg: #F8FAFC;
			}
			body { font-family: 'Roboto', sans-serif; background: var(--bg); color: var(--navy); margin: 0; }
			h1, h2 { font-family: 'Inter', sans-serif; letter-spacing: -0.02em; }
			.card { background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); padding: 2rem; max-width: 450px; margin: 2rem auto; }
			input, select, button { width: 100%; padding: 0.8rem; margin: 0.5rem 0; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 1rem; }
			button { background: var(--primary); color: white; font-weight: bold; border: none; cursor: pointer; transition: transform 0.1s; }
			button:active { transform: scale(0.98); }
			.hidden { display: none; }
		</style>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

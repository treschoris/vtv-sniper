---
interface Props { title?: string; }
const { title = "VTV Próxima – Calculadora de Vencimientos 2026" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<link href="https://googleapis.com/css2?family=Inter:wght@600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

		<style is:global>
			:root { --primary: #2563EB; --navy: #1E293B; --bg: #F8FAFC; }
			* { box-sizing: border-box; }
			body { font-family: 'Roboto', sans-serif; background: var(--bg); color: var(--navy); margin: 0; padding: 0; }
			h1, h2 { font-family: 'Inter', sans-serif; letter-spacing: -0.02em; }
			.card { background: white; border-radius: 12px; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); padding: 2.5rem; max-width: 500px; margin: 3rem auto 1rem; }
			input, select { width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 1rem; }
			input:focus, select:focus { outline: 2px solid var(--primary); border-color: transparent; }
			.hidden { display: none; }
		</style>
	</head>
	<body>
		<main id="main-content">
			<slot />
		</main>
	</body>
</html>

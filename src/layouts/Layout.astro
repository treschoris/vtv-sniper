---
interface Props {
  title?: string;
}

const {
  title = "VTV Próxima – Calculadora de Vencimientos 2026",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Calculadora oficial de vencimientos VTV 2026 para CABA y PBA" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --primary: #2563eb;
        --navy: #1e293b;
        --bg: #f8fafc;
        --border: #e2e8f0;
        --text-muted: #64748b;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Roboto", sans-serif;
        background: var(--bg);
        color: var(--navy);
        margin: 0;
        padding: 0;
        line-height: 1.6;
      }

      h1,
      h2,
      h3 {
        font-family: "Inter", sans-serif;
        letter-spacing: -0.02em;
        font-weight: 600;
      }

      main {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        padding: 2rem;
        max-width: 450px;
        width: 100%;
        margin: 1rem;
      }

      input,
      select {
        width: 100%;
        padding: 0.8rem;
        margin: 0.5rem 0;
        border-radius: 8px;
        border: 1px solid var(--border);
        font-size: 1rem;
        font-family: inherit;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      input:focus,
      select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      input::placeholder {
        color: var(--text-muted);
      }

      button {
        width: 100%;
        padding: 0.8rem;
        margin: 0.5rem 0;
        border-radius: 8px;
        border: none;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .hidden {
        display: none;
      }

      @media (max-width: 640px) {
        .card {
          padding: 1.5rem;
        }

        h1
